{
  "manifest_version": 3,
  "name": "豆瓣收藏角标",
  "version": "1.0.0",
  "description": "在豆瓣电影条目页封面显示角标，点击后打开豆瓣原生收藏对话框（评分 / 短评 / 状态仍在豆瓣自己的界面里完成）。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "豆瓣收藏角标",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://movie.douban.com/*",
        "https://search.douban.com/movie/*"
      ],
      "css": ["content.css"],
      "js": ["collectTarget.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://movie.douban.com/subject/*"
      ],
      "js": ["collectTarget.js", "pageBridge.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
