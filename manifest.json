{
  "manifest_version": 3,
  "name": "豆瓣看过角标",
  "version": "3.1.0",
  "description": "在豆瓣电影封面左上角用 emoji 显示未看/想看/在看/看过与电影/剧集类型；只读、点击穿透到封面。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "豆瓣看过角标",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "host_permissions": [
    "https://movie.douban.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://movie.douban.com/*",
        "https://search.douban.com/movie/*"
      ],
      "css": ["content.css"],
      "js": ["markCore.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
